# App
NEXT_PUBLIC_APP_URL=https://paganno.at

# Relayer (server-side only)
RELAYER_PRIVATE_KEY=base58_encoded_relayer_keypair
PRIVY_APP_SECRET=your_privy_app_secret
HELIUS_API_KEY=your_helius_key
# Required: the webhook rejects every request when this is unset
HELIUS_WEBHOOK_SECRET=your_helius_webhook_secret

# PIX (P1 — Redis migration)
OPENPIX_APP_ID=your_openpix_key
# PIX payouts stay off unless this is "true" AND the claim went to PIX_TREASURY_WALLET
PIX_PAYOUTS_ENABLED=false
PIX_TREASURY_WALLET=
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
